# OfficeHub settings for Portainer.
# Stacks → Add stack → Environment variables → "Load variables from .env file".

# Image version to run, e.g. 1.0.0 (or "latest")
OFFICEHUB_VERSION=latest

# Port on the server where OfficeHub is reachable
FRONTEND_PORT=8080

# First administrator – created on the very first start when the database is empty.
# Use a strong password and change it after signing in.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# true = fictional demo people and data instead of a real admin (for testing only)
DEMO_MODE=false
DEMO_LANGUAGE=de

# Set to true when OfficeHub runs behind HTTPS (reverse proxy)
COOKIE_SECURE=false

# Nightly backups of database and files (Administration → Backups). Empty = a volume of their own.
# Better: a folder or NAS share on the server, e.g. /mnt/nas/officehub-backups
BACKUP_PATH=

SESSION_HOURS=12
MAX_UPLOAD_MB=15

# Time zone for time tracking (clock in/out and daily totals)
TIMEZONE=Europe/Vienna

# Address of the portal as people open it – used for links in e-mails
PORTAL_URL=https://officehub.example.com

# Optional: e-mail notifications through your own mail server.
# Leave SMTP_HOST empty to switch e-mail off.
SMTP_HOST=
SMTP_PORT=587
# starttls (port 587), ssl (port 465) or none
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=officehub@example.com

# Office editing (Collabora) and video meetings (Jitsi, with a relay for people on other networks) work without any
# setting here. Passwords between OfficeHub and these servers are made automatically on the first start.
# For people outside the office open these ports to the server: UDP 10000 (meetings), UDP+TCP 3478 and
# UDP 49160-49200 (relay).
#
# Optional extras – add to COMPOSE_PROFILES and redeploy:
#   onlyoffice  ONLYOFFICE as a second editor (needs 2-4 GB RAM)
COMPOSE_PROFILES=
# The server's public IP address for meetings. Empty: what the name in PORTAL_URL resolves to.
PUBLIC_IP=

# OfficeHub settings for Portainer.
# Stacks → Add stack → Environment variables → "Load variables from .env file".

# Image version to run, e.g. 1.0.0 (or "latest")
OFFICEHUB_VERSION=latest

# Port on the server where OfficeHub is reachable
FRONTEND_PORT=8080

# First administrator – created on the very first start when the database is empty.
# Use a strong password and change it after signing in.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# true = fictional demo people and data instead of a real admin (for testing only)
DEMO_MODE=false
DEMO_LANGUAGE=de

# Set to true when OfficeHub runs behind HTTPS (reverse proxy)
COOKIE_SECURE=false

SESSION_HOURS=12
MAX_UPLOAD_MB=15

# Time zone for time tracking (clock in/out and daily totals)
TIMEZONE=Europe/Vienna

# Address of the portal as people open it – used for links in e-mails
PORTAL_URL=https://officehub.example.com

# Optional: e-mail notifications through your own mail server.
# Leave SMTP_HOST empty to switch e-mail off.
SMTP_HOST=
SMTP_PORT=587
# starttls (port 587), ssl (port 465) or none
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=officehub@example.com

# Optional: edit Word, Excel and PowerPoint files in the browser with your own office server.
# 1. Choose one or both: COMPOSE_PROFILES=collabora  /  onlyoffice  /  collabora,onlyoffice
# 2. Set the matching URL below (these are addresses inside the stack, keep them as they are).
COMPOSE_PROFILES=
COLLABORA_URL=
# COLLABORA_URL=http://collabora:9980
ONLYOFFICE_URL=
# ONLYOFFICE_URL=http://onlyoffice
# A long random text, used by OfficeHub and ONLYOFFICE to trust each other
ONLYOFFICE_JWT_SECRET=
# true if people reach the portal through HTTPS
COLLABORA_SSL_TERMINATION=false

# Optional: video meetings and calls with your own Jitsi server.
# Add "jitsi" to COMPOSE_PROFILES (e.g. COMPOSE_PROFILES=jitsi or collabora,jitsi) and set two random texts.
# People need HTTPS (browsers only allow camera and microphone there) and UDP port 10000 open to the server.
JITSI_APP_SECRET=
JITSI_INTERNAL_PASSWORD=
# The server's public IP address if people connect from outside the office network
JITSI_PUBLIC_IP=

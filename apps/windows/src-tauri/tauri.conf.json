{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OfficeHub",
  "version": "1.0.0",
  "identifier": "app.officehub.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; img-src 'self' data:; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "OfficeHub",
    "shortDescription": "OfficeHub",
    "longDescription": "OfficeHub, your company's portal, in its own window: notifications, calls and the number of new messages even when the window is closed.",
    "category": "Business",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["German", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}

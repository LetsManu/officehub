# Copy to .env and adjust. Never commit the real .env file.

# true = create fictional demo people, requests, announcements and documents on first start.
DEMO_MODE=true
# Language of the demo content: de or en
DEMO_LANGUAGE=de

# First administrator, created on first start when DEMO_MODE=false and no users exist.
# Change the password after the first sign-in.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Hours until a sign-in expires
SESSION_HOURS=12
# Set to true when OfficeHub is served over HTTPS
COOKIE_SECURE=false
# Largest allowed upload in MB
MAX_UPLOAD_MB=15

# Ports on the host
FRONTEND_PORT=8080
BACKEND_PORT=8000

# Office editing (WordCraft, DeckCraft, GridCraft) and video meetings work without any setting.
# Optional extras: Jitsi for larger meetings (needs UDP port 10000), ONLYOFFICE as a second editor.
# COMPOSE_PROFILES=jitsi,onlyoffice
# JITSI_PUBLIC_IP=
